function Window:Slider(name, options, callback)
        local min = options.min or 0
        local max = options.max or 100
        local default = options.default or 0
        local precise = options.precise or false
        local location = options.location or self.flags
        local flag = options.flag or ""
        local callback = callback or function() end

        location[flag] = default

        local Slider = Instance.new("Frame")
        local slider = Instance.new("TextButton")
        local slide = Instance.new("ImageLabel")
        local UIGradient = Instance.new("UIGradient")
        local Text_2 = Instance.new("TextLabel")

        Slider.Name = "Slider"
        Slider.Parent = holder
        Slider.BackgroundTransparency = 1
        Slider.Size = UDim2.new(1,0,0,25)

        slider.Name = "SliderButton"
        slider.Parent = Slider
        slider.BackgroundColor3 = Color3.fromRGB(50,50,50)
        slider.BorderSizePixel = 0
        slider.Position = UDim2.new(0,0,0.5,-5)
        slider.Size = UDim2.new(1,0,0,10)
        slider.AutoButtonColor = false
        slider.Text = ""

        slide.Name = "Slide"
        slide.Parent = slider
        slide.BackgroundColor3 = Color3.fromRGB(255,255,255)
        slide.BorderSizePixel = 0
        slide.Size = UDim2.new((default - min) / (max - min),0,1,0)
        slide.Image = "rbxassetid://3570695787"
        slide.ScaleType = Enum.ScaleType.Slice
        slide.SliceCenter = Rect.new(100,100,100,100)

        UIGradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0,Color3.fromRGB(255,0,0)),
            ColorSequenceKeypoint.new(1,Color3.fromRGB(0,255,0))
        }
        UIGradient.Parent = slide

        Text_2.Name = "Text"
        Text_2.Parent = Slider
        Text_2.BackgroundTransparency = 1
        Text_2.Position = UDim2.new(0,5,0,0)
        Text_2.Size = UDim2.new(1,-5,1,0)
        Text_2.Font = Enum.Font.GothamBold
        Text_2.TextColor3 = Color3.fromRGB(255,255,255)
        Text_2.TextSize = 12
        Text_2.TextXAlignment = Enum.TextXAlignment.Left
        Text_2.Text = name.." : "..default

        local sliding = false

        slider.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                sliding = true
            end
        end)

        slider.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                sliding = false
            end
        end)

        game:GetService("UserInputService").InputChanged:Connect(function(input)
            if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                local pos = math.clamp((input.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X,0,1)
                slide.Size = UDim2.new(pos,0,1,0)
                local val = min + (max - min) * pos

                if precise then
                    val = roundDecimals(val,2)
                else
                    val = math.floor(val)
                end

                location[flag] = val
                Text_2.Text = name.." : "..val
                spawn(function() callback(val) end)
            end
        end)

        Update(25)
    end


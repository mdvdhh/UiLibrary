    function Window:String(options)
        local str = options.string or ""
        return str
    end

    function Window:Search(color)
        local searchbar = Instance.new("TextBox")
        searchbar.Parent = holder
        searchbar.PlaceholderText = "Search"
        searchbar.Text = ""
        searchbar.ClearTextOnFocus = false
        searchbar.Size = UDim2.new(1,0,0,20)
        searchbar.BackgroundColor3 = Color3.fromRGB(50,50,50)
        searchbar.TextColor3 = color or Color3.fromRGB(255,255,0)
        searchbar.Font = Enum.Font.Gotham
        searchbar.TextSize = 12

        local function UpdateList()
            local query = searchbar.Text:lower()
            for _,v in pairs(holder:GetChildren()) do
                if v:IsA("Frame") then
                    local label = v:FindFirstChild("Text") or v:FindFirstChild("Title")
                    if label and label:IsA("TextLabel") or label:IsA("TextButton") then
                        if query == "" or string.find(label.Text:lower(),query) then
                            v.Visible = true
                        else
                            v.Visible = false
                        end
                    end
                end
            end
        end

        searchbar:GetPropertyChangedSignal("Text"):Connect(UpdateList)

        Update(20)
    end

    return Window
end

function Lib:CreateWindowNew(Config)
    local Window = self:CreateWindow(Config.Title)

    local API = {}

    function API:Section(data)
        return Window:Section(data.Title)
    end

    function API:Label(data)
        return Window:Label(data.Title)
    end

    function API:Button(data)
        return Window:Button(data.Title, data.Callback)
    end

    function API:Toggle(data)
        return Window:Toggle(
            data.Title,
            {
                location = data.Location or {},
                flag = data.Flag or data.Title,
                default = data.Value or false
            },
            data.Callback
        )
    end

    function API:Slider(data)
        return Window:Slider(
            data.Title,
            {
                location = data.Location or {},
                flag = data.Flag or data.Title,
                min = data.Value.Min,
                max = data.Value.Max,
                default = data.Value.Default,
                precise = data.Precise or false
            },
            data.Callback
        )
    end

    function API:Dropdown(data)
        return Window:Dropdown(
            data.Title,
            {
                location = data.Location or {},
                flag = data.Flag or data.Title,
                list = data.Values,
                search = data.Search or false,
                PlayerList = data.PlayerList or false
            },
            data.Callback
        )
    end

    function API:Input(data)
        return Window:Box(
            data.Title,
            {
                location = data.Location or {},
                flag = data.Flag or data.Title,
                type = data.Type,
                hold = data.Placeholder
            },
            data.Callback
        )
    end

    function API:Keybind(data)
        return Window:Bind(
            data.Title,
            {
                location = data.Location or {},
                flag = data.Flag or data.Title,
                default = data.Value
            },
            data.Callback
        )
    end

    return API
end

return Lib